---
import { Image } from "astro:assets";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import heroImg from "@/assets/atelier-hero.jpg";
import { siteConfig } from "@/config/site";
import { getProducts, requireProduct } from "@/data/products";

const products = await getProducts();
const featured = siteConfig.featured.homepageGrid.map((slug) => requireProduct(products, slug));
const solo = requireProduct(products, siteConfig.featured.homepageSolo);

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;

const facts = [
  { value: "02", label: "Founders" },
  { value: "LA", label: "Based in" },
  { value: "∞", label: "Possibilities" },
  { value: "01", label: "Shared vision" },
];

const disciplines = [
  {
    number: "01",
    name: "Photography & Film",
    copy: "Capturing people, places, events, and stories worth sharing.",
  },
  {
    number: "02",
    name: "Digital & Design",
    copy: "Websites, branding, and digital experiences built with purpose.",
  },
  {
    number: "03",
    name: "Music & Production",
    copy: "Sound, creative direction, and bringing ideas to life.",
  },
  {
    number: "04",
    name: "Creative Connections",
    copy: "Connecting good people, complementary talents, and new opportunities.",
  },
];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Pardes Creative Studio",
  url: siteUrl,
  slogan: "Ancient principles. Modern solutions.",
  email: "pardes@markket.place",
  telephone: "+18189434961",
  address: {
    "@type": "PostalAddress",
    addressLocality: "North Hollywood",
    addressRegion: "CA",
    addressCountry: "US",
  },
  sameAs: ["https://www.instagram.com/pardes.creative.studio"],
};
---

<BaseLayout
  title="Pardes Creative Studio — Ancient Principles. Modern Solutions."
  description="Pardes Creative Studio brings together photography, film, music, design, web development, and creative collaboration in Los Angeles."
>
  <main id="main-content">
    <!-- Hero -->
    <section
      class="shell grid items-center gap-x-12 gap-y-10 pb-8 pt-12 md:grid-cols-12 md:pb-16 md:pt-24"
    >
      <div class="hero-in md:col-span-6">
        <p class="label mb-8">Independent creative studio · Los Angeles</p>

        <h1 class="type-hero">
          Ancient principles.<br />
          Modern solutions.
        </h1>

        <p class="type-lead mt-7 max-w-[44ch]">
          We bring together creativity, technology, and meaningful connections to help people and
          businesses bring their ideas to life.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Start a conversation</a>
          <a href="/about" class="btn btn-outline">Get to know us</a>
        </div>
      </div>

      <figure class="hero-in md:col-span-6" style="--reveal-delay:120ms">
        <div class="overflow-hidden bg-surface">
          <Image
            src={heroImg}
            alt="Creative work and visual storytelling by Pardes Creative Studio"
            width={1600}
            height={1400}
            format="webp"
            loading="eager"
            decoding="sync"
            class="parallax aspect-[4/3] w-full object-cover object-center md:aspect-[8/7]"
          />
        </div>
        <figcaption
          class="mono mt-3 flex justify-between gap-4 text-[0.625rem] uppercase tracking-[0.05em] text-muted"
        >
          <span>Ideas into reality</span>
          <span>North Hollywood · LA</span>
        </figcaption>
      </figure>
    </section>

    <!-- Studio facts -->
    <div class="mt-14 border-y border-line md:mt-20">
      <dl class="shell grid grid-cols-2 md:grid-cols-4">
        {
          facts.map((fact, index) => (
            <div class="fact" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <dt class="label">{fact.label}</dt>
              <dd class="mt-2.5 text-2xl font-medium tracking-[-0.03em] md:text-3xl">
                {fact.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Introduction -->
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>

      <div class="mt-8 grid gap-10 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-5" data-reveal>
          <p class="label mb-6">A different kind of studio</p>
          <h2 class="type-h2 max-w-[14ch]">Good ideas grow together.</h2>
        </div>

        <div class="md:col-span-7 md:pt-10" data-reveal>
          <p class="type-body max-w-[55ch]">
            Started by Daveed and Sagiv in North Hollywood, Pardes is an independent creative studio
            built around complementary skills, shared curiosity, and a love for making things.
          </p>

          <p class="type-body mt-6 max-w-[55ch]">
            From photography and film to music, websites, and digital experiences, we combine our
            talents and collaborate with a wider network of creatives and professionals to make
            projects happen.
          </p>

          <a href="/about" class="link link-mono mt-8 inline-block text-muted">
            More about Pardes →
          </a>
        </div>
      </div>
    </section>

    <!-- Disciplines -->
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>

      <div class="mt-8 flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="label mb-5">What we bring together</p>
          <h2 class="type-h2 max-w-[16ch]">Many disciplines. One creative vision.</h2>
        </div>
      </div>

      <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 md:mt-16">
        {
          disciplines.map((discipline, index) => (
            <article
              class="border-t border-line pt-6"
              data-reveal
              style={`--reveal-delay:${index * 90}ms`}
            >
              <span class="mono text-xs text-accent">{discipline.number}</span>
              <h3 class="type-h3 mt-4">{discipline.name}</h3>
              <p class="type-body mt-4 max-w-[38ch] text-[0.9375rem]">{discipline.copy}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Featured work / existing products -->
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>

      <div class="mt-8 flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="label mb-5">Selected work</p>
          <h2 class="type-h2 max-w-[14ch]">Things we've been creating.</h2>
        </div>

        <a href="/catalog" class="link link-mono pb-1.5 text-muted">Explore the collection</a>
      </div>

      <div class="mt-12 grid gap-x-8 gap-y-14 md:mt-14 md:grid-cols-3">
        {
          featured.map((product, index) => (
            <ProductCard product={product} index={index} revealDelay={index * 110} />
          ))
        }
      </div>
    </section>

    <!-- Featured individual project -->
    <section class="mt-24 md:mt-36">
      <div class="shell grid items-center gap-10 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-7 lg:col-span-8">
          <a
            href={`/products/${solo.slug}`}
            class="group block overflow-hidden bg-surface"
            data-reveal="mask"
            aria-label={`${solo.name} — ${solo.shortDescription}`}
          >
            <div>
              <Image
                src={solo.images[0]}
                alt={solo.name}
                width={1600}
                height={1100}
                loading="lazy"
                format="webp"
                class="aspect-[5/4] w-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-[1.04] md:aspect-[16/11]"
              />
            </div>
          </a>
        </div>

        <div class="md:col-span-5 lg:col-span-4" data-reveal style="--reveal-delay:140ms">
          <p class="label mb-5">A closer look</p>
          <h2 class="type-h2">Thoughtful work, made with purpose.</h2>

          <p class="type-body mt-6 max-w-[44ch]">
            Every project has its own character. We believe in thoughtful details, intentional
            choices, and creating things that have a reason to exist.
          </p>

          <a href={`/products/${solo.slug}`} class="btn btn-primary mt-9">Explore the project</a>
        </div>
      </div>
    </section>

    <!-- Philosophy -->
    <section class="shell mt-24 md:mt-36">
      <div class="rule" data-reveal="line"></div>

      <div class="grid gap-10 py-10 md:grid-cols-12 md:gap-16 md:py-16">
        <div class="md:col-span-5" data-reveal>
          <p class="label mb-6">Beyond the deliverable</p>
          <h2 class="type-h2">Better work through better connections.</h2>
        </div>

        <div class="md:col-span-7 space-y-6 md:pt-10" data-reveal>
          <p class="type-body">
            We believe a good creative studio should be more than the sum of its services. Our goal
            is to help local businesses, independent creators, and organizations grow.
          </p>

          <p class="type-body">
            Sometimes we do that directly. Sometimes it's an introduction to a photographer,
            designer, musician, printer, developer, or another professional who is just right for
            the job.
          </p>

          <p class="type-body">
            Whether it's a simple set of portraits or an elaborate production, we enjoy finding the
            right people, sharing ideas, and making good things happen together.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="shell mt-24 border-t border-line py-24 text-center md:mt-36 md:py-36">
      <p class="label mb-6">Have something in mind?</p>

      <h2 class="type-h1 mx-auto mb-8 max-w-2xl">Let's create something meaningful.</h2>

      <p class="type-body mx-auto mb-10 max-w-xl">
        Have a project, an idea, or simply want to connect? We'd love to hear from you.
      </p>

      <a href="/contact" class="btn btn-primary">Get in touch</a>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
</BaseLayout>
