---
import BaseLayout from "@/layouts/BaseLayout.astro";
import workshopImg from "@/assets/atelier-workshop.jpg";
import { pageTitle } from "@/config/site";
---

<BaseLayout
  title={pageTitle("About")}
  description="Meet Pardes Creative Studio — a collaborative creative studio founded by Daveed and Sagiv in North Hollywood, Los Angeles."
>
  <main id="main-content">
    <!-- Intro -->
    <section class="shell py-24 md:py-36">
      <div class="max-w-3xl">
        <p class="text-xs tracking-[0.3em] uppercase text-accent mb-8">A little about us</p>

        <h1 class="type-h1 mb-8">
          Creative work.<br />
          Good people.<br />
          Better connections.
        </h1>

        <p class="text-muted text-lg md:text-xl leading-relaxed max-w-2xl">
          Pardes Creative Studio was started in North Hollywood, Los Angeles, by Daveed and Sagiv —
          two creatives with complementary skills, different backgrounds, and a shared love for
          making things happen.
        </p>
      </div>
    </section>

    <!-- Studio image -->
    <section class="shell pb-20 md:pb-28">
      <div class="aspect-[16/9] overflow-hidden rounded-xl bg-surface">
        <img
          src={workshopImg.src}
          alt="Pardes Creative Studio"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </section>

    <!-- Philosophy -->
    <section class="shell py-20 md:py-28 border-t border-border">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20">
        <div>
          <p class="text-xs tracking-[0.3em] uppercase text-accent mb-6">What we bring together</p>
          <h2 class="type-h2">
            Different talents.<br />
            Shared vision.
          </h2>
        </div>

        <div class="space-y-6 text-muted leading-relaxed">
          <p>
            We bring together photography, film, music, web development, design, and social media,
            combining our experience, creativity, and networks to help people bring their ideas to
            life.
          </p>

          <p>
            Sometimes that means capturing a beautiful moment, producing a video, building a
            website, or helping a business find its voice online. Other times, it means putting the
            right people in the same room and seeing what we can create together.
          </p>
        </div>
      </div>
    </section>

    <!-- Services / Capabilities -->
    <section class="shell py-20 md:py-28 border-t border-border">
      <div class="max-w-2xl mb-14">
        <p class="text-xs tracking-[0.3em] uppercase text-accent mb-6">What we do</p>
        <h2 class="type-h2 mb-5">Many ways to create.</h2>
        <p class="text-muted leading-relaxed">
          Different projects call for different talents. Here's where our work and collaborations
          come together.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-x-12 gap-y-12">
        <article>
          <span class="text-accent text-sm">01</span>
          <h3 class="type-h3 mt-3 mb-3">Photography & Film</h3>
          <p class="text-muted leading-relaxed">
            Events, portraits, brand stories, promotional videos, and creative productions.
          </p>
        </article>

        <article>
          <span class="text-accent text-sm">02</span>
          <h3 class="type-h3 mt-3 mb-3">Digital & Design</h3>
          <p class="text-muted leading-relaxed">
            Websites, branding, digital experiences, and social media that help businesses connect
            with people.
          </p>
        </article>

        <article>
          <span class="text-accent text-sm">03</span>
          <h3 class="type-h3 mt-3 mb-3">Music & Production</h3>
          <p class="text-muted leading-relaxed">
            Music, sound, creative direction, and bringing different elements together into
            something memorable.
          </p>
        </article>

        <article>
          <span class="text-accent text-sm">04</span>
          <h3 class="type-h3 mt-3 mb-3">Community & Connections</h3>
          <p class="text-muted leading-relaxed">
            Introductions, partnerships, referrals, and finding the right people to make projects
            happen.
          </p>
        </article>
      </div>
    </section>

    <!-- Collaboration -->
    <section class="shell py-20 md:py-28 border-t border-border">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20">
        <div>
          <p class="text-xs tracking-[0.3em] uppercase text-accent mb-6">More than services</p>
          <h2 class="type-h2">Good things grow together.</h2>
        </div>

        <div class="space-y-6 text-muted leading-relaxed">
          <p>We believe good creative work starts with good relationships.</p>

          <p>
            Our goal isn't simply to deliver a service and move on. We want to help local
            businesses, independent creators, and organizations grow — not only through the work we
            do ourselves, but through the people we know and the connections we make.
          </p>

          <p>
            Need a photographer? A musician? A designer, developer, printer, producer, or someone to
            help bring a bigger production together? We enjoy finding the right people for the job.
          </p>

          <p>
            From a simple set of business portraits to an elaborate creative production, we approach
            every project with curiosity, care, and a willingness to collaborate.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="shell py-24 md:py-36 border-t border-border text-center">
      <p class="text-xs tracking-[0.3em] uppercase text-accent mb-6">
        Let's make something together
      </p>

      <h2 class="type-h1 max-w-2xl mx-auto mb-8">Have an idea? Let's talk.</h2>

      <p class="text-muted max-w-xl mx-auto mb-10 leading-relaxed">
        Whether you have a fully formed vision or just an idea you're trying to figure out, we'd
        love to hear about it.
      </p>

      <a
        href="/contact"
        class="inline-flex items-center justify-center border border-current rounded-full px-8 py-3 hover:bg-accent hover:text-white hover:border-accent transition-colors"
      >
        Get in touch
      </a>
    </section>
  </main>
</BaseLayout>
